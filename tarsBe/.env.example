# Copy to .env and set the key. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_PATH=data/tutor.sqlite3
TURN_TIMEOUT_SECONDS=180
MODEL_TIMEOUT_SECONDS=60
MAX_CONCURRENT_TURNS=4
# Optional shared token for local API access. Not a replacement for user accounts.
BACKEND_API_TOKEN=
# JSON list; no client connection is enabled by default.
CORS_ORIGINS=[]
# Existing GNANI_API is also accepted. Keep either secret in this backend only.
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v2.5
GNANI_VOICE=Kaveri
GNANI_LANGUAGE=en-IN
SPEECH_TIMEOUT_SECONDS=60
