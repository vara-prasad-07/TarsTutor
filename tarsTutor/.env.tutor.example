# Optional server-side proxy overrides. Defaults work for sibling tarsBe/.
TUTOR_BACKEND_URL=http://127.0.0.1:8000
# If blank, Vite reads BACKEND_API_TOKEN from ../tarsBe/.env automatically.
TUTOR_BACKEND_API_TOKEN=
# GEMINI_API_KEY belongs only in ../tarsBe/.env.
# Optional continuous monorepo type checking (uses substantial memory).
# npm run build:tutor always checks types before building.
VITE_APP_ENABLE_CHECKER=false
